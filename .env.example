# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/failball?schema=public"

# NextAuth.js Configuration
# The base URL of your application (no trailing slash)
NEXTAUTH_URL="http://fantasyfailball.com"

# A random string used to hash tokens, sign cookies and generate cryptographic keys
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="+PVL8161wuNGU+o2TdopvtSaN4GGHDD9K9tlgljssyQ="

# Resend Configuration (for password reset emails)
# Get your API key from https://resend.com
RESEND_API_KEY=""

# Sender address for outgoing email. Must be on a domain verified in Resend.
# Falls back to Resend's dev sender (onboarding@resend.dev) if unset.
EMAIL_FROM="Failball <noreply@fantasyfailball.com>"

# Application URL (used for password reset links)
APP_URL="http://fantasyfailball.com"

# ============================================
# NFL data pipeline
# ============================================

# Play-by-play source. Failball derives every scoring category from PBP itself.
# sportsdataio (default, PAID live) | sportradar (PAID live alt) | nflverse (free, post-game only)
NFL_PBP_PROVIDER="sportsdataio"
SPORTSDATAIO_API_KEY=""   # SPORTS_DATA_IO_KEY is accepted as an alias
SPORTRADAR_API_KEY=""
SPORTRADAR_BASE_URL="https://api.sportradar.com/nfl/official/trial/v7/en"

# Charting is licensed ONLY for pcDrop + pcRouteNotTargeted (not derivable from
# a play result). "none" leaves both at 0, which scores 0.
NFL_CHARTING_PROVIDER="none"
CHARTING_BASE_URL=""
CHARTING_API_KEY=""

# Free player metadata / injuries / ADP
NFL_PLAYER_PROVIDER="sleeper"
SLEEPER_BASE_URL="https://api.sleeper.app/v1"

# Free post-game PBP, used for backfill / reconciliation / local testing
NFLVERSE_BASE_URL="https://github.com/nflverse/nflverse-data/releases/download/pbp"
NFLVERSE_SCHEDULE_URL="https://raw.githubusercontent.com/nflverse/nfldata/master/data/games.csv"

# Shared secret for the /api/sync/* cron routes
CRON_SECRET=""

# Optional hosted pub/sub (Pusher/Ably style) mirror for live score pushes.
# SSE at /api/live/stream works without it; use this when serverless instances
# make in-process fan-out unreliable.
REALTIME_WEBHOOK_URL=""
REALTIME_WEBHOOK_SECRET=""

# Postgres for the DB-backed live-sync smoke test (npm test skips it if unset)
TEST_DATABASE_URL=""
